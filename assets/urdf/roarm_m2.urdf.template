<?xml version="1.0" ?>
<!--
  RoArm-M2 URDF, cleaned up from the official Waveshare roarm_ws ROS2 package
  (waveshareteam/roarm_ws, src/roarm_main/roarm_description) for direct use
  outside ROS (e.g. PyBullet). xacro includes / $(find ...) package paths were
  stripped and inlined; kinematics, limits and inertials are unchanged.

  Mesh paths use the {{MESH_DIR}} placeholder, substituted with an absolute
  path at load time (see roarm_rl/sim.py: _materialize_urdf).
-->
<robot name="roarm_m2">

  <material name="silver">
    <color rgba="0.700 0.700 0.700 1.000"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0.0032 0 0.04" rpy="0 0 0" />
      <mass value="0.2562183" />
      <inertia ixx="0.00029211" ixy="0" ixz="0" iyy="0.00035719" iyz="0" izz="0.000349421" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="{{MESH_DIR}}/base_link.stl" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="{{MESH_DIR}}/base_link.stl" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>
  </link>

  <link name="link1">
    <inertial>
      <origin xyz="0 0 -0.015" rpy="0 0 0" />
      <mass value="0.0729177" />
      <inertia ixx="4.68465E-05" ixy="0" ixz="0" iyy="3.32107E-05" iyz="0" izz="5.01023E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="{{MESH_DIR}}/link1.stl" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="{{MESH_DIR}}/link1.stl" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>
  </link>

  <link name="link2">
    <inertial>
      <origin xyz="0.122 0 0" rpy="0 0 0" />
      <mass value="0.0703216" />
      <inertia ixx="5.46501E-05" ixy="0" ixz="0" iyy="0.000423091" iyz="0" izz="0.000404557" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="{{MESH_DIR}}/link2.stl" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="{{MESH_DIR}}/link2.stl" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>
  </link>

  <link name="link3">
    <inertial>
      <origin xyz="0.002 -0.13687 0.0059" rpy="0 0 0" />
      <mass value="0.0269773" />
      <inertia ixx="0.000199591" ixy="0" ixz="0" iyy="8.01674E-06" iyz="0" izz="0.000196918" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="{{MESH_DIR}}/link3.stl" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="{{MESH_DIR}}/link3.stl" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>
  </link>

  <link name="gripper_link">
    <inertial>
      <origin xyz="0.029 0.0027 -0.00078" rpy="0 0 0" />
      <mass value="0.0028708" />
      <inertia ixx="5.23216E-07" ixy="0" ixz="0" iyy="1.82071E-06" iyz="0" izz="1.60231E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="{{MESH_DIR}}/gripper_link.stl" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="{{MESH_DIR}}/gripper_link.stl" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>
  </link>

  <link name="hand_tcp"></link>

  <joint name="base_link_to_link1" type="revolute">
    <origin xyz="0.0100000008759151 0 0.123059270461044" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="link1" />
    <axis xyz="0 0 1" />
    <limit lower="-3.1416" upper="3.1416" effort="10" velocity="3" />
  </joint>

  <joint name="link1_to_link2" type="revolute">
    <origin xyz="0 0 0" rpy="-1.5708 -1.5708 0" />
    <parent link="link1" />
    <child link="link2" />
    <axis xyz="0 0 1" />
    <limit lower="-1.5708" upper="1.5708" effort="10" velocity="3" />
  </joint>

  <joint name="link2_to_link3" type="revolute">
    <origin xyz="0.236815132922094 0.0300023995170449 0" rpy="0 0 1.5708" />
    <parent link="link2" />
    <child link="link3" />
    <axis xyz="0 0 1" />
    <limit lower="-1" upper="2.95" effort="10" velocity="3" />
  </joint>

  <joint name="link3_to_gripper_link" type="revolute">
    <origin xyz="0.002906 -0.21599 -0.00066683" rpy="-1.5708 0 -1.5708" />
    <parent link="link3" />
    <child link="gripper_link" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="1.5" effort="10" velocity="3" />
  </joint>

  <joint name="link3_to_hand_tcp" type="fixed">
    <origin xyz="0.002 -0.2802 0" rpy="1.5708 0 -1.5708" />
    <parent link="link3" />
    <child link="hand_tcp" />
  </joint>

</robot>
